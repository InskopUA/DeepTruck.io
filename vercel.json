{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/i/:key/photo/:photo",
      "destination": "https://yqpeebgmqtqoxumzfrsq.supabase.co/functions/v1/driver-tracking/inspection/photos/:key/photo/:photo"
    },
    {
      "source": "/i/:key",
      "destination": "https://yqpeebgmqtqoxumzfrsq.supabase.co/functions/v1/driver-tracking/inspection/photos/:key"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/login",
      "destination": "/admin/login"
    },
    {
      "source": "/signup",
      "destination": "/admin/signup"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "DeepTruck Verify",
  "version": "0.2.0",
  "description": "Verify carrier contacts, collect driver documents, and keep a shared record on Central Dispatch.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.centraldispatch.com/*",
    "https://motus.dot.gov/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.centraldispatch.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DeepTruck Verify",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png",
      "48": "src/assets/icon-48.png"
    }
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  }
}
